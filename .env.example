# ==============================================================================
# NAVIGATE - Serverless Interactive Demo Platform Configuration
# ==============================================================================

# --- Firebase Client Configuration (Web & Extension) ---
# Create a free project at https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Cloudflare R2 Public CDN URL (Safe for client browsers) ---
VITE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Chrome Extension Production Config ---
# The URL where your studio is deployed (used by the Chrome Extension to redirect after recording)
VITE_STUDIO_URL=http://localhost:3000

# --- Runtime Mode ---
# Set to 'true' to force simulated storage without connecting to live Firebase/R2 during offline preview
VITE_ENABLE_OFFLINE_MOCK=false

# ==============================================================================
# FIREBASE CLOUD FUNCTIONS SERVER-SIDE SECRETS (Never exposed to browser)
# Set these in packages/functions/.env
# ==============================================================================
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=interactive-demos
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
