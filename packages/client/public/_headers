# Netlify Headers for NAVIGATE by Rotaract South Asia MDIO
# Allows seamless iframe embedding on rsamdio.org, district websites, and member portals

/*
  Content-Security-Policy: frame-ancestors 'self' https://*.rsamdio.org https://rsamdio.org https://*.rotaract.org https://rotaract.org https://*.rotary.org *;
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
