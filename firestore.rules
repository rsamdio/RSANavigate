rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if caller is super_admin
    function isSuperAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Helper function to check if caller is an approved creator or super_admin
    function isCreatorOrAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['creator', 'super_admin']);
    }

    // Interactive Demos collection
    match /demos/{demoId} {
      allow read: if request.auth != null;
      allow create, update, delete, write: if isCreatorOrAdmin();
      
      match /steps/{stepId} {
        allow read, write: if isCreatorOrAdmin();
      }

      match /snapshots/{snapshotId} {
        allow read, write: if isCreatorOrAdmin();
      }
    }

    // Role-Based Access Control (RBAC): Users collection (/users/{userId})
    match /users/{userId} {
      // Authenticated creators and admins can read user profiles
      allow read: if isCreatorOrAdmin();
      
      // Only Super Admins can provision new users
      allow create: if isSuperAdmin();
      
      // Super admins can update creator roles (cannot demote super admins); users can update their own display info
      allow update: if (
        isSuperAdmin() && 
        (resource.data.role != 'super_admin' || request.resource.data.role == 'super_admin') &&
        (request.auth.uid != userId || request.resource.data.role == resource.data.role)
      ) || (
        request.auth != null && 
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role
      );
      
      // Only super admin can delete creator user documents (cannot delete super admins or self)
      allow delete: if isSuperAdmin() && resource.data.role != 'super_admin' && request.auth.uid != userId;
    }
  }
}
